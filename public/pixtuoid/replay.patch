+    /// Map an explicit replay step to the four research roles.
+    pub fn replay_step(&mut self, step: u32, now_ms: f64) {
+        let now = pixtuoid_scene::anim::from_epoch_ms(now_ms);
+        for i in 0..4 {
+            self.reducer.apply(&mut self.scene, script::replay_start(i), now, Transport::Jsonl);
+            self.reducer.apply(&mut self.scene, script::replay_end(i), now, Transport::Hook);
+        }
+        let role = match step { 0 => 0, 1 => 1, 2 => 2, 3 => 3, 4 => 2, 5 => 3, 6 => 0, _ => 3 };
+        let labels = ["Hypothesis", "Design cases", "Clean baseline", "Verify baseline", "Injected case", "Verify result", "Fidelity review", "Session stopped"];
+        let label = labels.get(step as usize).copied().unwrap_or("Session stopped");
+        self.reducer.apply(&mut self.scene, script::replay_tool(role, label), now, Transport::Hook);
+    }
