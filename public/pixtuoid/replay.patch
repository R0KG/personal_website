+pub(crate) fn replay_start(i: usize) -> AgentEvent { session_start(i) }
+
+pub(crate) fn replay_tool(i: usize, label: &str) -> AgentEvent {
+    AgentEvent::tool_use_start(cast_id(i), Some(format!("replay-{i}")), Some(ToolDetail::Generic { display: label.to_string() }))
+}
+
+pub(crate) fn replay_end(i: usize) -> AgentEvent {
+    AgentEvent::ToolUseEnd { agent_id: cast_id(i), tool_use_id: Some(format!("replay-{i}")) }
+}
